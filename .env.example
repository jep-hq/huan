# ===========================================
# HUAN - Environment Configuration Template
# ===========================================
# Copy this file to .env and fill in your values
# For production, generate secure random values for all secrets

# ===========================================
# ENVIRONMENT
# ===========================================
# Options: development, production
ENVIRONMENT=development

# ===========================================
# POSTGRES (Main Database)
# ===========================================
POSTGRES_DB=huan
POSTGRES_USER=huan
POSTGRES_PASSWORD=changeme_secure_password

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# AUTHENTIK DATABASE
# ===========================================
AUTHENTIK_DB_PASSWORD=changeme_secure_password

# ===========================================
# AUTHENTIK CONFIGURATION
# ===========================================
# Generate with: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=changeme_generate_with_openssl_rand_base64_60

# OAuth2/OIDC Client Credentials (get from Authentik admin panel)
AUTHENTIK_CLIENT_ID=your_client_id_here
AUTHENTIK_CLIENT_SECRET=your_client_secret_here

# Authentik URLs (internal and external)
AUTHENTIK_URL=http://authentik-server:9000
AUTHENTIK_PUBLIC_URL=http://localhost:9000

# OAuth2 Redirect URI (should point to frontend callback)
AUTHENTIK_REDIRECT_URI=http://localhost:3000/auth/callback

# ===========================================
# BACKEND CONFIGURATION
# ===========================================
# Generate with: openssl rand -base64 32
SECRET_KEY=changeme_generate_with_openssl_rand_base64_32

# Database connection (auto-constructed from POSTGRES_* vars)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Spark Configuration
SPARK_MASTER_URL=spark://spark-master:7077

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# API URL (external facing)
NUXT_PUBLIC_API_URL=http://localhost:8001

# Authentik URL for frontend (external facing)
NUXT_PUBLIC_AUTHENTIK_URL=http://localhost:9000

# Client ID (safe to be public)
NUXT_PUBLIC_AUTHENTIK_CLIENT_ID=${AUTHENTIK_CLIENT_ID}

# ===========================================
# FLOWER (Celery Monitoring)
# ===========================================
FLOWER_UNAUTHENTICATED_API=true

# ===========================================
# SPARK CONFIGURATION
# ===========================================
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# ===========================================
# PORT MAPPINGS (customize if needed)
# ===========================================
POSTGRES_PORT=5432
REDIS_PORT=6380
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443
BACKEND_PORT=8001
FRONTEND_PORT=3000
FLOWER_PORT=5555
SPARK_MASTER_UI_PORT=8081
SPARK_MASTER_PORT=7077
